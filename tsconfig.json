{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // tests/ import through the node TS loader, which resolves explicit .ts
    // specifiers. Safe with noEmit: it permits the extension, never requires it.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@contracts": ["./src/contracts/index.ts"],
      "@desktop/*": ["./src/*"],
      "@contracts/*": ["./src/contracts/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    // scripts/ and tests/ call into main-process services directly. Leaving them
    // out of the program let the harnesses drift out of sync with
    // registerIpcHandlers while `npm run typecheck` still reported clean.
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "forge.config.ts",
    "vite.*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "worker",
    "examples",
    "db",
    "build",
    ".next",
    ".vite",
    "out"
  ]
}
