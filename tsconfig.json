{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@contracts": ["./packages/contracts/index.ts"],
      "@desktop/*": ["./apps/desktop/src/*"],
      "@contracts/*": ["./packages/contracts/*"]
    }
  },
  "include": [
    "apps/desktop/src/**/*.ts",
    "apps/desktop/src/**/*.tsx",
    "packages/**/*.ts",
    "forge.config.ts",
    "apps/desktop/*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "worker",
    "examples",
    "db",
    "build",
    ".next",
    ".vite",
    "out"
  ]
}
